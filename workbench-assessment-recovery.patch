+    db.exec('begin');
+    for (const [table, id, value] of [['records', 'id', 'body'], ['cache', 'key', 'value']]) {
+      const save = db.prepare('update ' + table + ' set ' + value + '=? where ' + id + '=?');
+      for (const row of db.prepare('select * from ' + table).all()) {
+        const previous = JSON.stringify(JSON.parse(row[value]));
+        const relocated = JSON.stringify(remap(JSON.parse(previous)));
+        if (previous !== relocated) save.run(relocated, row[id]);
+      }
+    }
+    db.exec('commit');
+  } finally { db.close(); }
