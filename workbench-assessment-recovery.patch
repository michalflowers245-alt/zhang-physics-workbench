+  } finally { handles.forEach(db => db.close()); }
+}
+
+function remapProductionPaths(data, backupRoots, roots) {
+  const db = new DatabaseSync(join(data, databases[3]));
+  const remap = value => {
+    if (typeof value === 'string') {
+      for (const kind of ['data', 'feedback']) {
+        if (isInside(backupRoots[kind], value)) return join(roots[kind], relative(backupRoots[kind], value));
+      }
+      return value;
+    }
+    if (Array.isArray(value)) return value.map(remap);
+    if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([k, child]) => [k, remap(child)]));
