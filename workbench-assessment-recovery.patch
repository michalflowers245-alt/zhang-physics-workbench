+import { createHash } from 'node:crypto';
+import { createReadStream, constants } from 'node:fs';
+import { copyFile, lstat, mkdir, readdir, readFile, readlink, realpath, symlink, writeFile } from 'node:fs/promises';
+import { basename, dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
+import { backup, DatabaseSync } from 'node:sqlite';
+
+const databases = [
+  'workbench.sqlite',
+  'physics-exam/exam-engine.sqlite',
+  'physics-exam/material-library.sqlite',
+  'teaching-production/production.sqlite',
+];
+const busyQueries = [
+  "select count(*) n from jobs where status in ('queued','running')",
+  "select count(*) n from engine_entity where collection='importJobs' and json_extract(payload,'$.status') in ('queued','running')",
+  null,
+  "select count(*) n from records where json_extract(body,'$.status') in ('queued','running','uploading','generating','saving','processing','exporting','transcribing')",
+];
+
+function isInside(parent, child) {
+  return parent === child || child.startsWith(parent + sep);
+}
+
+function safeEntry(name) {
+  return typeof name === 'string' && !isAbsolute(name) && !name.includes('\\') && name.split('/').every(part => part && part !== '.' && part !== '..');
+}
+
+async function digest(file) {
+  const hash = createHash('sha256');
+  for await (const chunk of createReadStream(file)) hash.update(chunk);
+  return hash.digest('hex');
+}
+
+async function listFiles(root, sub = '') {
+  const names = [];
+  for (const item of await readdir(join(root, sub), { withFileTypes: true })) {
+    const name = sub ? sub + '/' + item.name : item.name;
+    if (name.endsWith('-wal') || name.endsWith('-shm') || name.endsWith('-journal')) continue;
+    if (name === 'backups' || name === 'physics-exam/exam-backups') continue;
+    if (item.isDirectory()) names.push(...await listFiles(root, name));
+    else if ((item.isFile() || item.isSymbolicLink()) && safeEntry(name)) names.push(name);
+    else throw new Error('备份目录含不支持的文件类型，请先检查路径 ' + name);
+  }
+  return names.sort();
+}
+
+async function inspect(file) {
+  const stat = await lstat(file);
+  if (!stat.isFile()) throw new Error('发现非普通文件 ' + file);
+  const signature = [stat.dev, stat.ino, stat.size, stat.mtimeMs, stat.ctimeMs].join(':');
+  return { stat, signature };
+}
+
+function verifyDb(file) {
+  const db = new DatabaseSync(file, { readOnly: true });
+  try {
+    if (db.prepare('pragma quick_check').get().quick_check !== 'ok') throw new Error('数据库完整性检查失败 ' + file);
+  } finally { db.close(); }
+}
+
+async function snapshot(data, feedback, out) {
+  if ([data, feedback].some(root => isInside(root, out)) || isInside(data, feedback) || isInside(feedback, data)) {
+    throw new Error('请选择独立的备份目录和两个独立的来源目录');
+  }
+  await mkdir(out, { mode: 0o700 });
+  const roots = { data, feedback };
+  const handles = [];
+  try {
+    for (const name of databases) handles.push(new DatabaseSync(join(data, name), { readOnly: true }));
+    const revisions = handles.map(db => db.prepare('pragma data_version').get().data_version);
+    const assertIdle = () => handles.forEach((db, index) => {
+      const sql = busyQueries[index];
+      if (sql && db.prepare(sql).get().n) throw new Error('工作台有进行中的任务，等任务结束后重新备份');
+    });
+    assertIdle();
+    const inventory = {};
+    const files = [];
+    for (const [kind, root] of Object.entries(roots)) {
+      await mkdir(join(out, kind), { mode: 0o700 });
+      inventory[kind] = await listFiles(root);
+      for (const name of inventory[kind]) {
