+function transactionalFixture(record) {
+  return {
+    get: () => record,
+    checkRevision(expected, current) {
+      if (expected !== current) throw Object.assign(new Error("outdated"), { status: 409 });
+    },
+    transact(expected, update) {
+      this.checkRevision(expected, record.revision);
+      const draft = structuredClone(record.state);
+      update(draft);
+      record.state = draft;
+      record.revision++;
+      return record;
+    }
+  };
+}
