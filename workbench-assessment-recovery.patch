+import { randomUUID } from 'node:crypto';
+import { assessmentReviewSource, confirmationCurrent, fingerprint } from '../shared/domain.mjs';
+import { AppError } from './store.mjs';
+
+function validChoice(answer) {
+  const value = String(answer ?? '').trim().normalize('NFKC').toUpperCase();
+  return /^[A-D]$/.test(value) ? value : '';
+}
+
+function prepare(session, question) {
+  if (!session) throw new AppError('找不到指定课次', 404);
+  if (!session.wrongbook.columns.includes(question) || !['knowledge','scores','pdf'].every(kind => confirmationCurrent(session, kind))) {
+    throw new AppError('请先确认答案、成绩和原卷匹配，再选择一道题', 422);
+  }
+  const standard = validChoice(session.confirmations.knowledge.snapshot[question]?.answer);
+  if (!standard) throw new AppError('批量校对只适用于标准答案是单个 A、B、C 或 D 的题目', 422);
+  const pdf = session.confirmations.pdf.snapshot;
+  const pairs = new Map(pdf.pairs.map(p => [p.studentId, p]));
+  const scores = new Map(session.confirmations.scores.snapshot.map(r => [r.studentId, r]));
+  const active = (session.wrongbook.batches || []).filter(batch => batch.question === question && !batch.undoneAt);
+  const processed = new Set(active.flatMap(batch => batch.changes.map(change => change.studentId)));
+  const source = assessmentReviewSource(session);
+  const students = session.wrongbook.rows.map(row => {
+    const paper = pairs.get(row.studentId), score = scores.get(row.studentId);
+    const existing = String(row.answers?.[question] ?? '').trim();
+    const reason = !paper || paper.matchMethod !== 'manual' ? '未确认原卷'
+      : !score || ['缺考','请假','未考','缺席','未参加'].includes(score.status) || score.score == null || String(score.score).trim() === '' || !Number.isFinite(Number(score.score)) ? '缺考或未录分'
+      : row.checked || processed.has(row.studentId) || existing ? '已有校对记录' : '';
+    const recognized = row.choiceCandidates?.[question];
+    const suggested = !reason && recognized?.source === source && recognized.uncertain === false &&
+      Number.isInteger(recognized.page) && recognized.page >= paper.start + 1 && recognized.page <= paper.end + 1
+      ? validChoice(recognized.answer) : '';
+    return { studentId: row.studentId, name: row.name, reason, suggested, current: existing,
+      page: paper ? paper.start + 1 : null, lastPage: paper ? paper.end + 1 : null };
+  });
+  return { question, standard, materialId: pdf.materialId, source, students,
+    batches: active.slice(-10).reverse().map(batch => ({ id: batch.id, answer: batch.answer, count: batch.changes.length, at: batch.at })) };
+}
+
+function preview(info, body) {
+  const answer = validChoice(body.answer);
+  const chosen = new Set(Array.isArray(body.studentIds) ? body.studentIds : []);
+  if (!answer || !chosen.size || chosen.size > 250 || [...chosen].some(id => typeof id !== 'string')) {
+    throw new AppError('请选择同一选项及至少一位已核对原卷的学生，单批最多 250 人', 422);
+  }
+  const students = info.students.filter(item => chosen.has(item.studentId) && !item.reason);
+  if (students.length !== chosen.size) throw new AppError('名单或校对状态已改变，请重新选择', 422);
+  return { answer, correct: answer === info.standard, students,
+    token: fingerprint([info.question, info.source, info.standard, answer, students]) };
+}
+
+export function reviewBatch(store, sessionId, body) {
+  const record = store.get();
+  store.checkRevision(body.expectedRevision, record.revision);
+  const question = typeof body.question === 'string' ? body.question : '';
+  const session = record.state.sessions[sessionId];
+  const info = prepare(session, question);
+  if (body.action === 'load') return info;
+  if (body.action === 'preview') return preview(info, body);
+  if (body.action !== 'apply' && body.action !== 'undo') throw new AppError('无效批量校对操作', 422);
+
+  return store.transact(record.revision, state => {
+    const current = state.sessions[sessionId];
+    const book = current.wrongbook;
+    book.batches ||= [];
+    const rows = new Map(book.rows.map(row => [row.studentId, row]));
+    if (body.action === 'apply') {
+      const selected = preview(info, body);
+      if (body.token !== selected.token) throw new AppError('预览已过期，请重新预览', 422);
+      const changes = selected.students.map(({ studentId }) => {
+        const row = rows.get(studentId);
+        row.answers ||= {};
+        const previous = Object.hasOwn(row.answers, question) ? row.answers[question] : null;
+        const applied = selected.correct ? '' : selected.answer;
+        row.answers[question] = applied;
+        return { studentId, previous, applied };
