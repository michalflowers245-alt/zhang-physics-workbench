+import { createHash, randomUUID } from 'node:crypto';
+import ExamDomain from '../exam-engine/exam-domain.js';
+import StudentSets from '../exam-engine/student-question-set.js';
+import { paperContext } from './physics-paper-diagnosis.mjs';
+import { AppError } from './store.mjs';
+
+const text = value => String(value ?? '').trim();
+const normalized = value => text(value).normalize('NFKC').toUpperCase();
+const day = () => new Date(Date.now() + 8 * 3600_000).toISOString().slice(0, 10);
+const missingTag = /^(?:待.*|未知|无|未分类)$/;
+const activeStatuses = ['awaiting', 'review'];
+function versionHash(q) {
+  return createHash('sha256').update(JSON.stringify([StudentSets.contentHash(q), q.answer, q.method, q.explanation])).digest('hex');
+}
+
+function context(record, engine, sessionId, correctionId) {
+  const session = record.state.sessions[sessionId];
+  const correction = session?.corrections.find(c => c.id === correctionId);
+  if (!correction) throw new AppError('找不到指定订正任务', 404);
+  const retests = correction.retests || [];
+  const paper = paperContext(record, sessionId);
+  const bind = engine.settings?.reviewedPaperBindings?.[sessionId];
+  const source = bind?.paperIdentity === paper.wrongbook.paperIdentity
+    ? ExamDomain.reviewedPaperMapping(engine, paper.wrongbook, paper.knowledge).get(String(correction.question)) : null;
+  const origin = source;
+  const row = paper.wrongbook.rows.find(r => r.studentId === correction.studentId);
+  const response = row && ExamDomain.reviewedRowResponse(row, String(correction.question));
+  const originalAnswer = response?.outcome === 'blank' ? '空题' : text(row?.answers?.[correction.question]);
+  const stillCorrecting = ['blank', 'incorrect'].includes(response?.outcome) && originalAnswer === text(correction.originalAnswer) &&
+    text(correction.standard?.answer) === text(paper.knowledge[correction.question]?.answer);
+  const model = text(origin?.physicalModel);
+  let reason = '';
+  if (correction.status !== 'passed' || correction.attempts?.at(-1)?.status !== 'passed') reason = '请先完成订正并由教师复核通过';
+  else if (!paper.available || !stillCorrecting) reason = '原卷校对已修订，请先重新核对本题订正依据';
+  else if (!origin || !model || missingTag.test(model)) reason = '请在逐生诊断关联原卷，并核对本题的考法标签';
+  return { session, correction, retests, origin, model, reason };
+}
+
+function availableQuestions(engine, record, ctx) {
+  const used = new Set();
+  for (const session of Object.values(record.state.sessions)) {
+    for (const c of session.corrections || []) if (c.studentId === ctx.correction.studentId) {
+      for (const retest of c.retests || []) used.add(retest.questionId);
+    }
+  }
+  return engine.questions.filter(q => !used.has(q.id) && !q.generated && q.sourceFileId &&
+    q.canonicalExamId && q.canonicalExamId !== ctx.origin.canonicalExamId &&
+    text(q.physicalModel) === ctx.model && normalized(q.stem).replace(/\s+/g, '') !== normalized(ctx.origin.stem).replace(/\s+/g, '') &&
+    ExamDomain.eligiblePaperQuestion(q) && StudentSets.readiness(q).ready).slice(0, 24);
+}
+
+function currentQuestion(engine, retest) {
+  const q = engine.questions.find(q => q.id === retest.questionId);
+  if (!q || !ExamDomain.eligiblePaperQuestion(q) || !StudentSets.readiness(q).ready || versionHash(q) !== retest.contentHash) {
+    throw new AppError('原题已撤下或更新，请结束这次复测后另选一题', 422);
+  }
+  return q;
+}
+
+export function assessmentRetest(store, stored, sessionId, body) {
+  const record = store.get(), engine = stored.engine;
+  store.checkRevision(body.expectedRevision, record.revision);
+  const ctx = context(record, engine, sessionId, body.correctionId);
+  const current = ctx.retests.find(item => item.id === body.retestId);
+  if (body.action === 'load') {
+    const choices = ctx.reason || ctx.retests.some(r => activeStatuses.includes(r.status)) ? [] : availableQuestions(engine, record, ctx);
+    return { reason: ctx.reason, model: ctx.model, retests: ctx.retests,
+      choices: choices.map(q => ({ id: q.id, source: [q.year, q.region, q.examType].filter(Boolean).join(' · '), number: q.questionNo, stem: text(q.stem).slice(0, 120) })) };
+  }
+  if (body.action === 'preview') {
+    if (!current || !activeStatuses.includes(current.status)) throw new AppError('本次复测已结束', 422);
+    if (ctx.reason) throw new AppError(ctx.reason, 422);
+    const q = currentQuestion(engine, current);
+    if (current.status === 'review') return { answer: current.firstAnswer, standard: q.answer, explanation: q.explanation || q.method || '' };
+    if (day() < current.dueOn) throw new AppError('到 ' + current.dueOn + ' 才开始本次独立复测', 422);
+    const dto = StudentSets.studentQuestionDTO(q);
+    return { question: dto };
+  }
+  if (body.action === 'assign') {
+    if (ctx.reason) throw new AppError(ctx.reason, 422);
+    if (ctx.retests.some(r => activeStatuses.includes(r.status))) throw new AppError('请先结束正在进行的复测', 422);
+    const q = availableQuestions(engine, record, ctx).find(q => q.id === body.questionId);
+    const dueOn = text(body.dueOn), time = new Date(dueOn + 'T00:00:00Z');
+    if (!q) throw new AppError('请选择一道已审核、不同卷且未用过的同考法题', 422);
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(dueOn) || !Number.isFinite(time.getTime()) || time.toISOString().slice(0, 10) !== dueOn || dueOn < day()) {
+      throw new AppError('请选择今天或以后的复测日期', 422);
+    }
+    return store.transact(record.revision, state => {
+      const correction = state.sessions[sessionId].corrections.find(c => c.id === ctx.correction.id);
+      (correction.retests ||= []).push({ id: randomUUID(), status: 'awaiting', questionId: q.id,
+        originalQuestionId: ctx.origin.id, contentHash: versionHash(q), dueOn, assignedAt: new Date().toISOString() });
+    });
+  }
+  if (!current || !activeStatuses.includes(current.status)) throw new AppError('本次复测已结束，首答已保留', 422);
+  if (body.action !== 'cancel' && ctx.reason) throw new AppError(ctx.reason, 422);
+  const at = new Date().toISOString();
+  let updates;
+  if (body.action === 'cancel') {
+    const reason = text(body.reason);
+    if (!reason || reason.length > 500) throw new AppError('请填写结束依据', 422);
+    updates = { status: 'cancelled', reason, reviewedAt: at };
+  } else if (body.action === 'submit' && current.status === 'awaiting') {
+    const firstAnswer = text(body.answer);
+    if (day() < current.dueOn) throw new AppError('到约定日期后再作答', 422);
+    if (!firstAnswer || firstAnswer.length > 4000 || body.independent !== true) throw new AppError('请填写首答并确认独立、无提示完成', 422);
+    const q = currentQuestion(engine, current);
+    const standard = normalized(q.answer), answer = normalized(firstAnswer);
+    const objective = /^(单项选择题|单选题)$/.test(q.type) && /^[A-D]$/.test(standard);
+    if (objective && !/^[A-D]$/.test(answer)) throw new AppError('单项选择题请填写一个选项 A、B、C 或 D', 422);
+    updates = { firstAnswer, submittedAt: at, independent: true, status: objective ? answer === standard ? 'passed' : 'retry' : 'review',
+      ...(objective ? { reviewedAt: at, reason: '依据审核后的单选答案核对' } : {}) };
+  } else if (body.action === 'review' && current.status === 'review') {
+    currentQuestion(engine, current);
+    const reason = text(body.reason);
+    if (!reason || reason.length > 500 || !['passed', 'retry'].includes(body.verdict)) throw new AppError('请选择结果并填写复核依据', 422);
+    updates = { status: body.verdict, reason, reviewedAt: at };
+  } else {
+    throw new AppError('复测状态已变更，请重新打开', 422);
+  }
+  return store.transact(record.revision, state => {
+    const correction = state.sessions[sessionId].corrections.find(c => c.id === ctx.correction.id);
+    Object.assign(correction.retests.find(r => r.id === current.id), updates);
+  });
+}
